# Application environment template: all settings declared in this project's
# application*.properties / configuration property classes, plus common runtime knobs.
# Optional overrides are commented out; uncomment only what your deployment needs.
# Spring Boot has many additional framework settings, not exhaustively listed here.
# Never commit real secrets or bake this file / Firebase credentials into an image.
# Spring does not automatically read .env: pass variables through your runner,
# Compose service env_file, or docker/podman run --env-file.
# Compose CLI --env-file only supplies interpolation values; it does not inject
# every variable into a service. Compose environment entries override env_file.
# The existing compose.yaml is LOCAL and overrides the profile, DB URL and Redis.
# Changing this file alone does not make that Compose configuration production-ready.
# Values use literal KEY=value container env-file syntax. For shell/systemd use,
# adapt quoting for values containing spaces (cron expressions, JVM options, JSON).
# Explicit aliases (e.g. APP_DB_URL) come from application properties. Other names
# use Spring binding: replace dots with underscores, REMOVE hyphens, uppercase.
# https://docs.spring.io/spring-boot/reference/features/external-config.html

# Runtime / profile. Select exactly the intended profile; no implicit production switch.
# SPRING_PROFILES_ACTIVE=production
# SERVER_PORT=8080
# SERVER_ADDRESS=0.0.0.0
# SERVER_SERVLET_CONTEXTPATH=/
# SERVER_SHUTDOWN=graceful
# SPRING_LIFECYCLE_TIMEOUTPERSHUTDOWNPHASE=30s
# Trust forwarded headers only when a trusted reverse proxy strips client-supplied headers.
# SERVER_FORWARDHEADERSSTRATEGY=none
# JVM options apply at container creation, not image build time.
# JAVA_TOOL_OPTIONS=-Xms128m -Xmx768m
# Additional mounted Spring properties/YAML; use a container-visible path.
# SPRING_CONFIG_ADDITIONALLOCATION=optional:file:/run/config/

# Shared application secrets
APP_JWT_SECRET=replace-with-base64-secret
APP_ENCRYPTION_PASSWORD=replace-with-random-long-secret
APP_ENCRYPTION_SALT=replace-with-hex-salt-from-openssl-rand-hex-32
APP_AUTH_RATE_LIMIT_KEY_SECRET=replace-with-a-separate-random-secret

# JWT lifetimes and authentication token lifetimes, in milliseconds.
# APP_JWT_ACCESSEXPIRATION=1800000
# APP_JWT_REFRESHSHORTEXPIRATION=86400000
# APP_JWT_REFRESHLONGEXPIRATION=2592000000
# APP_AUTH_ACTIVATIONTOKENEXPIRATION=345600000
# APP_AUTH_PASSWORDRESETTOKENEXPIRATION=3600000
# APP_AUTH_EMAILCHANGETOKENEXPIRATION=86400000

# Authentication rate limiting. Production uses Redis; local/test use in-memory storage.
# Keep forwarded-header trust off unless the backend is reachable only through a
# trusted proxy which sanitizes X-Forwarded-For. Never expose a trusting backend directly.
# APP_AUTH_RATELIMIT_ENABLED=true
# APP_AUTH_RATELIMIT_TRUSTFORWARDEDHEADERS=false
# APP_AUTH_RATELIMIT_REGISTRATIONMAXREQUESTS=5
# APP_AUTH_RATELIMIT_REGISTRATIONWINDOW=1m
# APP_AUTH_RATELIMIT_LOGINMAXREQUESTS=10
# APP_AUTH_RATELIMIT_LOGINWINDOW=1m

# Conversation message encryption / rotation. "default" uses the shared password/salt.
# Keep old keys until all messages encrypted with them have expired or been migrated.
# APP_ENCRYPTION_MESSAGEACTIVEKEYID=default
# Dynamic message-keys.<key-id>.password/salt are best supplied as JSON or mounted
# Spring properties/YAML. This single-line JSON example configures a new active key;
# it must contain real independent secrets and valid even-length hex salts before use.
# SPRING_APPLICATION_JSON={"app":{"encryption":{"message-active-key-id":"v1","message-keys":{"v1":{"password":"replace-with-new-message-secret","salt":"replace-with-hex-salt-from-openssl-rand-hex-32"}}}}}

# Database for BOTH local and production profiles. These credentials are local examples
# only: use a dedicated application role and a strong password in production.
# In a Compose network use db:5432 (the service name), not localhost.
# An external database needs its actual reachable hostname and TLS options as appropriate.
APP_DB_URL=jdbc:postgresql://localhost:5432/event_organizer
APP_DB_USERNAME=postgres
APP_DB_PASSWORD=password

# Database pool overrides (Hikari defaults unless a profile overrides them).
# Test profile uses maximum-pool-size=2, minimum-idle=0, idle-timeout=10000.
# SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE=10
# SPRING_DATASOURCE_HIKARI_MINIMUMIDLE=10
# SPRING_DATASOURCE_HIKARI_IDLETIMEOUT=600000
# SPRING_DATASOURCE_HIKARI_CONNECTIONTIMEOUT=30000
# SPRING_DATASOURCE_HIKARI_MAXLIFETIME=1800000

# Persistence / migrations. Keep validate + Flyway; do not use create/create-drop
# against production data. Hibernate must not manage the production schema.
# SPRING_JPA_HIBERNATE_DDLAUTO=validate
# SPRING_JPA_OPENINVIEW=false
# SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
# SPRING_SQL_INIT_MODE=never
# SPRING_FLYWAY_ENABLED=true
# SPRING_FLYWAY_LOCATIONS=classpath:db/migration

# Dedicated test database. The login must own this DB and have no admin rights/role memberships.
# Disposable-instance setup: src/test/resources/database/init-test-role.sql
APP_TEST_DB_URL=jdbc:postgresql://localhost:5432/event_organizer_test
APP_TEST_DB_USERNAME=eventorganizer_test
APP_TEST_DB_PASSWORD=test-only-password

# Geoapify city autocomplete and place details. Never commit a real API key.
GEOAPIFY_API_KEY=replace-with-geoapify-api-key
GEOAPIFY_CONNECT_TIMEOUT=3000
GEOAPIFY_READ_TIMEOUT=5000
# APP_GEOAPIFY_BASEURL=https://api.geoapify.com

# LOCAL ONLY: demo seeds. Do not enable seeds in a production deployment.
# Local seeds require a real place_id selected through city autocomplete.
# Disable seeds when no city has been selected; do not use a city name here.
APP_SEED_LOCAL_DATA_ENABLED=false
APP_SEED_CITY_EXTERNAL_ID=
# Optional API application root for logged demo links (include context path, not /api/v1).
# Empty uses localhost and the actual server port / SSL / context path.
APP_SEED_API_BASE_URL=

# Production SMTP is required for auth emails even when notification email is disabled.
# STARTTLS with authentication is enabled/required by the production profile.
APP_MAIL_HOST=smtp.example.com
APP_MAIL_PORT=587
APP_MAIL_USERNAME=replace-with-mail-user
APP_MAIL_PASSWORD=replace-with-mail-password
APP_MAIL_FROM_ADDRESS=no-reply@example.com
# Frontend confirmation pages, not backend GET endpoints. The raw token is appended.
APP_MAIL_ACTIVATION_BASE_URL=https://your-frontend.example/activate-account?token=
APP_MAIL_EMAIL_CHANGE_BASE_URL=https://your-frontend.example/confirm-email-change?token=
# Password-reset links default to APP_FRONTEND_URL/reset-password?token=.
# Optional direct override; there is no APP_MAIL_PASSWORD_RESET_BASE_URL alias.
# APP_MAIL_PASSWORDRESETBASEURL=https://your-frontend.example/reset-password?token=
APP_MAIL_CONNECTION_TIMEOUT=5000
APP_MAIL_READ_TIMEOUT=10000
APP_MAIL_WRITE_TIMEOUT=10000
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true

# Frontend / CORS. Origins are scheme + host + optional port, not URL paths.
# Default allowed origins follow app.frontend.url in local/production profiles.
APP_FRONTEND_URL=https://your-frontend.example
# APP_API_CORS_ALLOWEDORIGINS=https://your-frontend.example,https://admin.your-frontend.example

# Production rate limiter Redis. Local and test profiles use an in-memory implementation.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# SPRING_DATA_REDIS_SSL_ENABLED=false
# SPRING_DATA_REDIS_CONNECTTIMEOUT=5s
# SPRING_DATA_REDIS_TIMEOUT=5s
# No Redis repositories are declared; optionally disable the repository scan noise.
# SPRING_DATA_REDIS_REPOSITORIES_ENABLED=false

# Production Firebase is disabled by default. Local/test use their own profile behavior.
# Enable only when push notifications are intended. Mount the JSON separately, read-only;
# this property is a path INSIDE the container, not a host path or the JSON contents.
# The runtime user (UID 10001 in Dockerfile) must be able to read the mounted file.
APP_FIREBASE_ENABLED=false
APP_FIREBASE_SERVICE_ACCOUNT_LOCATION=file:/run/secrets/firebase.json

# Notification worker and device maintenance
APP_NOTIFICATIONS_DELIVERY_WORKER_ENABLED=true
APP_NOTIFICATIONS_DELIVERY_POLL_DELAY=5s
APP_NOTIFICATIONS_DELIVERY_BATCH_SIZE=100
APP_NOTIFICATIONS_DELIVERY_MAX_ATTEMPTS=6
APP_NOTIFICATIONS_DELIVERY_RETRY_DELAYS=1m,5m,15m,30m,60m
APP_NOTIFICATIONS_DELIVERY_PROCESSING_TIMEOUT=10m
APP_NOTIFICATIONS_DEVICES_CLEANUP_ENABLED=true
APP_NOTIFICATIONS_DEVICES_STALE_AFTER=90d
APP_NOTIFICATIONS_DEVICES_CLEANUP_CRON=0 0 3 * * *
APP_NOTIFICATIONS_EMAIL_ENABLED=false

# Notification retention and backlog monitoring
APP_NOTIFICATIONS_RETENTION_CLEANUP_ENABLED=true
APP_NOTIFICATIONS_RETENTION_COMPLETED_FOR=90d
APP_NOTIFICATIONS_RETENTION_DEAD_FOR=180d
APP_NOTIFICATIONS_RETENTION_CLEANUP_CRON=0 15 3 * * *
APP_NOTIFICATIONS_RETENTION_BACKLOG_ALERT_THRESHOLD=1000

# Auth email worker, resend cooldown and delivery retention
APP_AUTH_EMAIL_WORKER_ENABLED=true
APP_AUTH_EMAIL_POLL_DELAY=5s
APP_AUTH_EMAIL_BATCH_SIZE=100
APP_AUTH_EMAIL_MAX_ATTEMPTS=6
APP_AUTH_EMAIL_RETRY_DELAYS=1m,5m,15m,30m,60m
APP_AUTH_EMAIL_PROCESSING_TIMEOUT=10m
APP_AUTH_EMAIL_RESEND_COOLDOWN=1m
APP_AUTH_EMAIL_CLEANUP_ENABLED=true
APP_AUTH_EMAIL_RETENTION=90d
APP_AUTH_EMAIL_CLEANUP_CRON=0 30 3 * * *

# Pagination and community limits. Data sizes use Spring units (MB); other limits are counts.
# APP_PAGINATION_DEFAULTPAGESIZE=20
# APP_COMMUNITY_MAXTAGSPEREVENT=10
# APP_COMMUNITY_MAXFILESPEREVENT=50
# APP_COMMUNITY_MAXFILESIZE=10MB
# APP_COMMUNITY_MAXEVENTFILESTORAGE=500MB
# APP_COMMUNITY_MAXDISPLAYFILENAMELENGTH=120
# APP_COMMUNITY_MAXATTENDEES=1000
# APP_COMMUNITY_MAXARCHIVEENTRIES=1000
# APP_COMMUNITY_MAXARCHIVEUNCOMPRESSEDSIZE=50MB
# APP_COMMUNITY_MAXARCHIVECOMPRESSIONRATIO=100
# Multipart defaults follow app.community.max-file-size. Override separately only
# intentionally: servlet limits can reject a request before application validation.
# SPRING_SERVLET_MULTIPART_MAXFILESIZE=10MB
# SPRING_SERVLET_MULTIPART_MAXREQUESTSIZE=10MB

# JSON serialization (matches the configured application default).
# SPRING_JACKSON_DATATYPE_DATETIME_WRITEDATESASTIMESTAMPS=false

# OpenAPI is disabled in production and enabled by the local profile.
# SPRINGDOC_APIDOCS_ENABLED=false
# SPRINGDOC_SWAGGERUI_ENABLED=false

# Actuator: retain the restrictive defaults; do not publicly expose env/configprops
# or database/Redis details. Production Redis health follows rate-limit.enabled.
# MANAGEMENT_ENDPOINTS_ACCESS_DEFAULT=none
# MANAGEMENT_ENDPOINT_HEALTH_ACCESS=read-only
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health
# MANAGEMENT_ENDPOINTS_JMX_EXPOSURE_EXCLUDE=*
# MANAGEMENT_ENDPOINT_HEALTH_SHOWDETAILS=never
# MANAGEMENT_ENDPOINT_HEALTH_SHOWCOMPONENTS=never
# MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=false
# MANAGEMENT_HEALTH_DEFAULTS_ENABLED=false
# MANAGEMENT_HEALTH_DB_ENABLED=true
# MANAGEMENT_HEALTH_REDIS_ENABLED=true

# Logging: optional quieter output; WARN/ERROR still show the actual failures.
# SPRING_MAIN_BANNERMODE=off
# LOGGING_LEVEL_ROOT=INFO
# LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=WARN
# LOGGING_LEVEL_ORG_HIBERNATE=WARN
# Test-only: omit the huge conditions report on context startup failure.
# SPRING_TEST_PRINTCONDITIONEVALUATIONREPORT=false
